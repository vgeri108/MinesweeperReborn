<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:MinesweeperReborn.Localization;assembly=MinesweeperReborn"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MinesweeperReborn.Views.ThemeSelect"
        Height="500" MinHeight="500"
        Width="500" MinWidth="500"
        Title="{x:Static loc:Strings.ThemeSelectTitle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static loc:Strings.ThemeSelectHeading}"
               Margin="10,0,10,5"
               Grid.Row="0"
               FontWeight="Bold"
               FontSize="16"/>

        <WrapPanel x:Name="ThemeList"
               Grid.Row="1"
               Margin="10,0,10,0"
               VerticalAlignment="Top"/>

        <StackPanel Grid.Row="2" Margin="10">
            <TextBlock x:Name="ThemeName"/>
            <TextBlock x:Name="ThemeCreator"/>
            <TextBlock x:Name="ThemeDescription" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Viewbox Stretch="Uniform" Grid.Column="0" Height="80">
                <StackPanel>
                    <Image x:Name="SelectedBoardIcon" Width="45"/>
                    <TextBlock Text="{x:Static loc:Strings.ThemeBoard}" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock x:Name="BoardSelected" HorizontalAlignment="Center"/>
                </StackPanel>
            </Viewbox>

            <Viewbox Stretch="Uniform" Grid.Column="1" Height="80">
                <StackPanel>
                    <Image x:Name="SelectedMineIcon" Width="45"/>
                    <TextBlock Text="{x:Static loc:Strings.ThemeMines}" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock x:Name="MinesSelected" HorizontalAlignment="Center"/>
                </StackPanel>
            </Viewbox>

            <Viewbox Stretch="Uniform" Grid.Column="2" Height="80">
                <StackPanel>
                    <Image x:Name="SelectedNumberIcon" Width="45"/>
                    <TextBlock Text="{x:Static loc:Strings.ThemeNumbers}" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock x:Name="NumbersSelected" HorizontalAlignment="Center"/>
                </StackPanel>
            </Viewbox>

            <Viewbox Stretch="Uniform" Grid.Column="3" Height="80">
                <StackPanel>
                    <Image x:Name="SelectedBackgroundIcon" Width="45"/>
                    <TextBlock Text="{x:Static loc:Strings.ThemeBackground}" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock x:Name="BackgroundSelected" HorizontalAlignment="Center"/>
                </StackPanel>
            </Viewbox>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Right" Margin="10">
            <Button Classes="dialog-button" x:Name="Canel" Content="{x:Static loc:Strings.Cancel}" Height="20" Width="120" Margin="0,0,5,0" Click="Cancel_Click"/>
            <Button Classes="dialog-button" x:Name="Save" Content="{x:Static loc:Strings.SaveGame}" Height="20" Width="120" Margin="5,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
