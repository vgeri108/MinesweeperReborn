<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MinesweeperReborn.Views.GameLose"
        Title="Vereség"
        Width="500" Height="250"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="13,5,13,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sajnos vesztett. Sok szerencsét a következő játékhoz!"
                   HorizontalAlignment="Center" Grid.Row="0"
                   Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TimeText"
                       Text="Idő: 000 másodperc"
                       Grid.Row="0" Grid.Column="0"/>

            <TextBlock x:Name="BestTime"
                       Text="Legjobb idő: 000 másodperc"
                       Grid.Row="1" Grid.Column="0"/>

            <TextBlock x:Name="Date"
                       Text="Dátum: 2026.01.01."
                       Grid.Row="1" Grid.Column="1"/>

            <TextBlock x:Name="PlayedGames"
                       Text="Lejátszott játékok: 000"
                       Grid.Row="2" Grid.Column="0"/>

            <TextBlock x:Name="WinnedGames"
                       Text="Megnyert játékok: 000"
                       Grid.Row="3" Grid.Column="0"/>

            <TextBlock x:Name="PercentageRating"
                       Text="Százalékos értékelés: 000%"
                       Grid.Row="3" Grid.Column="1"/>
        </Grid>

        <Button Classes="dialog-button" Grid.Row="2" Content="További játékok az interneten"
                Height="25"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="0,0,0,20" Click="MoreGames_Click"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Classes="dialog-button" x:Name="Exit" Content="Kilépés"
                Grid.Column="0" Margin="0,0,5,0" Click="Exit_Click"/>

            <Button Classes="dialog-button" x:Name="Replay" Content="Játék újraindítása"
                Grid.Column="1" Margin="5,0,5,0" Click="Replay_Click"/>

            <Button Classes="dialog-button" x:Name="NewGame" Content="Új játék"
                Grid.Column="2" Margin="5,0,0,0" Click="NewGame_Click"/>

        </Grid>
    </Grid>
</Window>
