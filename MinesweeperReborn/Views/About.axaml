<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:MinesweeperReborn.Localization;assembly=MinesweeperReborn"
        mc:Ignorable="d"
        x:Class="MinesweeperReborn.Views.About"
        Width="520"
        Height="390"
        MinWidth="520"
        MinHeight="390"
        CanResize="False"
        ShowInTaskbar="False"
        Title="{x:Static loc:Strings.About}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="AppLogo"
                   Width="56"
                   Height="56"
                   VerticalAlignment="Center"
                   Stretch="Uniform"/>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0"
                        Spacing="5">
                <TextBlock Text="{x:Static loc:Strings.About}"
                           FontSize="20"
                           FontWeight="Bold"/>
                <TextBlock Text="{x:Static loc:Strings.AboutDescription}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <Separator Grid.Row="1"/>

        <StackPanel Grid.Row="2"
                    Margin="42,24,30,12"
                    Spacing="12">
            <TextBlock x:Name="InfoText"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{x:Static loc:Strings.AboutLicense}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="20,8,30,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Classes="dialog-button"
                    Content="{x:Static loc:Strings.AboutMoreInfo}"
                    Height="30"
                    HorizontalAlignment="Left"
                    Click="MoreInfo_Click"/>
            <Button Grid.Column="1"
                    Classes="dialog-button"
                    Content="{x:Static loc:Strings.Ok}"
                    Height="30"
                    Width="90"
                    Click="OK_Click"/>
        </Grid>
    </Grid>
</Window>
