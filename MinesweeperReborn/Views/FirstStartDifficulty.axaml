<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:MinesweeperReborn.Localization;assembly=MinesweeperReborn"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MinesweeperReborn.Views.FirstStartDifficulty"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Title="{x:Static loc:Strings.FirstStartDifficultyTitle}" Height="330" Width="420">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static loc:Strings.FirstStartDifficultyPrompt}"
                   FontSize="16" Margin="0,0,0,20" Foreground="#FF0077B6"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">

            <Button Name="BeginnerButton" Click="NewBeginner"
                    HorizontalContentAlignment="Left" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#FF305995">
                <StackPanel>
                    <TextBlock FontSize="14"><Run Foreground="Green" Text="➜ "/><Run Text="{x:Static loc:Strings.Beginner}"/></TextBlock>
                    <TextBlock FontSize="12" Margin="10,0,0,0" Text="   "><Run Text="{x:Static loc:Strings.BeginnerMineCount}"/><Run Text=", "/><Run Text="{x:Static loc:Strings.BeginnerGrid}"/></TextBlock>
                </StackPanel>
            </Button>

            <Button Name="IntermediateButton" Click="NewIntermediate"
                    HorizontalContentAlignment="Left" Background="{x:Null}" Foreground="#FF305995" BorderBrush="{x:Null}">
                <StackPanel>
                    <TextBlock FontSize="14"><Run Foreground="Green" Text="➜ "/><Run Text="{x:Static loc:Strings.Intermediate}"/></TextBlock>
                    <TextBlock FontSize="12" Margin="10,0,0,0" Text="   "><Run Text="{x:Static loc:Strings.IntermediateMineCount}"/><Run Text=", "/><Run Text="{x:Static loc:Strings.IntermediateGrid}"/></TextBlock>
                </StackPanel>
            </Button>

            <Button Name="AdvancedButton" Click="NewAdvanced"
                    HorizontalContentAlignment="Left" Background="{x:Null}" Foreground="#FF305995" BorderBrush="{x:Null}">
                <StackPanel>
                    <TextBlock FontSize="14"><Run Foreground="Green" Text="➜ "/><Run Text="{x:Static loc:Strings.Advanced}"/></TextBlock>
                    <TextBlock FontSize="12" Margin="10,0,0,0" Text="   "><Run Text="{x:Static loc:Strings.AdvancedMineCount}"/><Run Text=", "/><Run Text="{x:Static loc:Strings.AdvancedGrid}"/></TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.FirstStartDifficultyNote}"
                   FontSize="12" TextWrapping="Wrap" Margin="-9,0,-9,-9" VerticalAlignment="Top" Height="40"
                   Padding="5"/>
    </Grid>
</Window>
