<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:MinesweeperReborn.Localization;assembly=MinesweeperReborn"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MinesweeperReborn.MainWindow"
        Title="{x:Static loc:Strings.AppTitle}">
    <Grid>
        
        <Grid.Background>
            <ImageBrush Source="/images/hatter.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{DynamicResource ThemeBackgroundBrush}">
    <MenuItem Header="{x:Static loc:Strings.GameMenu}">
        <MenuItem Header="{x:Static loc:Strings.NewGame}" x:Name="NewGame"/>
        <Separator/>
        <MenuItem Header="{x:Static loc:Strings.Statistics}" x:Name="Stats"/>
        <MenuItem Header="{x:Static loc:Strings.Settings}" x:Name="Settings"/>
        <MenuItem Header="{x:Static loc:Strings.ChangeAppearance}" x:Name="AppearanceMenu"/>
        <Separator/>
        <MenuItem Header="{x:Static loc:Strings.Exit}" x:Name="Exit"/>
    </MenuItem>

    <MenuItem Header="{x:Static loc:Strings.Settings}">
        <MenuItem Header="{x:Static loc:Strings.GameSettings}"/>
        <MenuItem Header="{x:Static loc:Strings.ApplicationSettings}"/>
        <Separator/>
        <MenuItem Header="{x:Static loc:Strings.CheckForUpdates}" x:Name="CheckForUpdates"/>
    </MenuItem>

    <MenuItem Header="{x:Static loc:Strings.HelpMenu}">
        <MenuItem Header="{x:Static loc:Strings.ShowHelp}" x:Name="Help"/>
        <Separator/>
        <MenuItem Header="{x:Static loc:Strings.About}" x:Name="About"/>
        <Separator/>
        <MenuItem Header="{x:Static loc:Strings.MoreGames}" x:Name="MoreGames"/>
    </MenuItem>
</Menu>

        <Viewbox Grid.Row="1"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="10">

            <!-- Referencia méret -->
            <Grid Width="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Játéktábla -->
                <UniformGrid x:Name="GameBoard"
                             Rows="5"
                             Columns="10"
                             Grid.Row="0"
                             Margin="0,0,0,10"/>

                <!-- Alsó információs sáv -->
                <DockPanel Grid.Row="1"
                           LastChildFill="True">

                    <!-- Bal oldal -->
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image x:Name="ClockImage"
                               Width="40"
                               Height="40"
                               Margin="0,0,8,0"/>

                        <Border x:Name="TimerBox"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                MinWidth="80">
                            <TextBlock x:Name="Timer"
                                       Text="0"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Jobb oldal -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="MineCounterBox"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                MinWidth="80"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="MineCounter"
                                       Text="10"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Image x:Name="FlowerImage"
                               Width="40"
                               Height="40"/>
                    </StackPanel>

                    <!-- Kitöltő -->
                    <Grid/>
                </DockPanel>

            </Grid>
        </Viewbox>

    </Grid>
</Window>
