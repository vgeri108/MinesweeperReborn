<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:MinesweeperReborn.Localization;assembly=MinesweeperReborn"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MinesweeperReborn.Views.AppSettingsMenu"
        Width="430"
        Height="440"
        CanResize="False"
        Title="{x:Static loc:Strings.ApplicationSettings}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0">
            <StackPanel>
                <GroupBox Header="{x:Static loc:Strings.UpdateSettings}">
                    <StackPanel>
                        <CheckBox x:Name="UpdateCheck" Margin="0,0,0,0" IsChecked="True">
                            <TextBlock Text="{x:Static loc:Strings.CheckForUpdatesOnStartup}"/>
                        </CheckBox>
                        <Button x:Name="CheckUpdates" Content="{x:Static loc:Strings.CheckForUpdates}" Margin="5" Click="CheckUpdates_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="{x:Static loc:Strings.SavedGames}">
                    <StackPanel>
                        <CheckBox x:Name="ContinueSaved" Content="{x:Static loc:Strings.AlwaysContinueSavedGame}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="SaveExit" Content="{x:Static loc:Strings.AlwaysSaveOnExit}" Margin="0,0,0,8"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="{x:Static loc:Strings.Ok}" Width="105" Click="OK_Click" Margin="0,0,10,0" Padding="2,0,2,0"/>
            <Button Content="{x:Static loc:Strings.Cancel}" Width="105" Click="Cancel_Click" Padding="2,0,2,0"/>
        </StackPanel>
    </Grid>
</Window>
