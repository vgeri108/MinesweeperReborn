<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <Reference Include="MinesweeperCore">
      <HintPath>MinesweeperCore.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <AvaloniaResource Include="images\**" />
    <AvaloniaResource Include="Assets\**" />
	  <EmbeddedResource Update="Localization\Strings.resx">
		  <Generator>MSBuild:Compile</Generator>
		  <StronglyTypedFileName>Localization\Strings.Designer.cs</StronglyTypedFileName>
		  <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
		  <StronglyTypedNamespace>MinesweeperReborn.Localization</StronglyTypedNamespace>
		  <StronglyTypedClassName>Strings</StronglyTypedClassName>
		  <PublicClass>true</PublicClass>
	  </EmbeddedResource>
  </ItemGroup>
</Project>
